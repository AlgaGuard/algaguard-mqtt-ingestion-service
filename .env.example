NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://algaguard:change-me@localhost:5432/algaguard
LOG_LEVEL=info
CONTRACTS_DIR=../algaguard-contracts
HTTP_BODY_LIMIT=256kb
MQTT_URL=mqtts://localhost:8884
MQTT_CLIENT_ID=algaguard-mqtt-ingestion-service
MQTT_CA_PATH=.local/pki/ca/ca.crt
MQTT_CERTIFICATE_PATH=.local/pki/services/mqtt-ingestion.crt
MQTT_PRIVATE_KEY_PATH=.local/pki/services/mqtt-ingestion.key
MQTT_SERVER_NAME=emqx
MQTT_MAX_PACKET_BYTES=262144
MQTT_MAX_SAMPLES_PER_BATCH=120
MQTT_QOS1_INFLIGHT=32
MQTT_KEEPALIVE_SECONDS=60
MQTT_SESSION_EXPIRY_SECONDS=3600
MQTT_RECONNECT_DELAY_MS=2000
MQTT_MAX_MESSAGES_PER_SECOND=200
KEYCLOAK_ISSUER=http://localhost:8080/realms/algaguard
SERVICE_CLIENT_ID=algaguard-mqtt-ingestion-service
SERVICE_CLIENT_SECRET=replace-with-secret
TELEMETRY_SERVICE_URL=http://localhost:3002
DEVICE_SERVICE_URL=http://localhost:3001

